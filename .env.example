# Browser-visible URL. When using Docker Compose, the browser reaches the API
# through localhost rather than the internal Docker service name.
# Web app (Vercel + Firebase). These values come from Firebase Console > Project settings > Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Administração e auditoria de acesso (somente no servidor; nunca use NEXT_PUBLIC_).
# Lista separada por vírgula dos e-mails autorizados a abrir /admin.
ADMIN_EMAILS=admin@exemplo.com
# JSON completo da chave de uma service account Firebase, em uma única linha.
# Cadastre somente no ambiente do servidor/Vercel; não versione a chave.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Slack OAuth de usuário, somente no servidor. Não usar NEXT_PUBLIC_.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# URL HTTPS registrada no Slack App, terminando em /api/integrations/slack/callback.
SLACK_REDIRECT_URI=
# Chave AES-256 de exatamente 32 bytes codificada em base64.
SLACK_TOKEN_ENCRYPTION_KEY=

# Assistente Gemini, somente servidor. Habilite depois de configurar segredo e modelo.
GEMINI_ASSISTANT_ENABLED=false
GEMINI_CORRECTIONS_ENABLED=false
# Server only. Comma-separated exact hosts verified on Kodland correction attachments.
KODLAND_CORRECTION_IMAGE_HOSTS=
# Escrita Kodland permanece indisponível até comprovar contrato externo.
KODLAND_CORRECTION_WRITE_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
# Quotas persistentes no Firestore. Falhas também consomem uma requisição.
GEMINI_REQUESTS_PER_MINUTE=2
GEMINI_REQUESTS_PER_DAY=10
GEMINI_GLOBAL_REQUESTS_PER_DAY=50

# Legacy API (migration-only; the web app no longer uses this in production).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# API configuration
APP_ENV=development
API_PORT=8000
# The default is a SQLite file at backend/data/aulapay.sqlite3. Leave this
# unset unless an absolute custom SQLite path or another supported database is
# intentionally required.
# DATABASE_URL=sqlite+pysqlite:////absolute/path/to/aulapay.sqlite3
CORS_ORIGINS=http://localhost:3000
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
