.env
# Environment files for the web workspace and legacy API. Keep examples
# versioned, but never commit provider keys, OAuth secrets, or access tokens.
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.secret
*service-account*.json
backend/.venv/
backend/data/*.sqlite3
backend/data/*.db
__pycache__/
*.py[cod]
frontend/.next/
frontend/out/
frontend/next-env.d.ts
coverage/
frontend/test-results/
frontend/playwright-report/

# local Codex dependency graph cache
.codex/graph/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
